<%- layout("layouts/boilerplate_superAdmin") %>

<body>
  <h1>Suppliers List</h1>
  <table>
    <thead>
      <tr>
        <th>Supplier</th>
        <th>Orders</th>
        <th>Revenue</th>
        <th>Status</th>
      </tr>
    </thead>
    <tbody>
      <% suppliers.forEach(function(supplier) { %>
        <tr>
          <td><%= supplier.name %></td>
          <td><%= supplier.ordersCount || 0 %></td> <!-- assuming you pass ordersCount -->
          <td>$<%= supplier.revenue || 0 %></td> <!-- assuming you pass revenue -->
          
          <td><span class="status-pill active"><%= supplier.status || 'Active' %></span></td> <!-- placeholder status -->
        </tr>
      <% }); %>
    </tbody>
  </table>
</body>