<%- layout("layouts/boilerplate_supplier") -%>
<body>

<div class="container">
    <!-- MAIN -->
    <div class="main">
        <!-- ORDERS CARD -->
        <h3>FullFilled Orders</h3>
        <div class="card">
<div class="table">

  <table>

    <tr>
      <th>Hospital</th>
      <th>Medicine</th>
      <th>Quantity</th>
      <th>Status</th>
      <th>Order date </th>
      <th>delivered date</th>
    </tr>

    <% orders.forEach(order => { %>
    <tr>

      <td>
        <%= order.hospitalId?.name || "Hospital" %>
      </td>

      <td>
        <%= order.medicineName %>
      </td>

      <td>
        <%= order.quantity %>
      </td>

      <td>
        <span class="status <%= order.status.toLowerCase() %>">
          fullFilled
        </span>
      </td>

        <td>
       <%= order.orderDate 
        ? new Date(order.orderDate).toLocaleDateString() 
        : "N/A" %>
      </td>

        <td>
        <%= order.deliveryDate 
        ? new Date(order.deliveryDate).toLocaleDateString() 
        : "N/A" %>
      </td>
       

    </tr>
    <% }) %>

  </table>

</div>


    </div>

</div>

</body>