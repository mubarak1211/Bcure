<%- layout("layouts/boilerplate_patient") -%>

<link rel="stylesheet" href="/user/search.css">

<div class="search-page">

  <h2 >Search Results</h2><br><br>

  <% if (doctors.length === 0) { %>
    <p class="no-results">No doctors found</p>
  <% } %>

  <div class="doctor-grid">

    <% doctors.forEach(doc => { %>

      <div class="doctor-card">
      
        <div class="doctor-info">
          <h3>Dr. <%= doc.fullName %></h3>
          <p class="specialization"><%= doc.specialization %></p>
          <p class="hospital-name"><%= doc.hospitalId.name %></p>
          
                <!-- Status Badge -->
          <span class="status-badge <%= doc.status %>">
          <%= doc.status %>
          </span>
        
        </div>

        <form action="/appointment/book" method="POST" class="booking-form">

          <input type="hidden" name="doctorId" value="<%= doc._id %>">
          <input type="hidden" name="hospitalId" value="<%= doc.hospitalId._id %>">

          <input type="date" name="appointmentDate" required>

          <input 
            type="text" 
            name="timeSlot" 
            placeholder="09:00 AM - 07:00 pM"
            required>

          <input 
            type="text" 
            name="reason" 
            placeholder="Reason">
        <p class="fee">
          Consultation Fee: ₹<%= doc.consultationFee || 500 %>
        </p>

        <input type="hidden" 
          name="appointmentFee" 
          value="<%= doc.consultationFee || 500 %>">

<button type="submit">
  Pay & Book Appointment
</button>

        </form>

      </div>

    <% }) %>

  </div>

</div>